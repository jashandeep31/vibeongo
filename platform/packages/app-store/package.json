{
  "name": "@repo/app-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chat-store": {
      "types": "./dist/stores/chat-store.d.ts",
      "import": "./dist/stores/chat-store.js"
    },
    "./playground-store": {
      "types": "./dist/stores/playground-store.d.ts",
      "import": "./dist/stores/playground-store.js"
    }
  },
  "scripts": {
    "dev": "tsc-watch -p ./tsconfig.json --onSuccess \"node dist/index.js\"",
    "build": "tsc -p ./tsconfig.json",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "react": "19.2.4",
    "typescript": "5.9.2",
    "tsc-watch": "^7.2.0"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.11",
    "@repo/db": "workspace:*",
    "zustand": "^5.0.11"
  },
  "peerDependencies": {
    "react": ">=19.2.0"
  }
}
