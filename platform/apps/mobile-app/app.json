{
  "expo": {
    "name": "VibeOnGo",
    "slug": "mobile-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/vibeongo-logo.png",
    "scheme": "vibeongo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/vibeongo-logo.png",
      "bundleIdentifier": "com.vibeongo.app"
    },
    "android": {
      "package": "com.vibeongo.app",
      "versionCode": 23,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "935cdf8b-4b80-4b31-9500-22e22fb871f7"
      }
    },
    "owner": "jashansingup"
  }
}
